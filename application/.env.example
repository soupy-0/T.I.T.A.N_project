# Solana Devnet RPC. Leave unset to use the standard public Devnet endpoint.
SOLANA_CLUSTER=devnet
# Optional custom RPC endpoint:
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Configure ONE of these. Keep wallet files outside the repository.
SOLANA_KEYPAIR_PATH=C:/Users/your-user/.config/solana/id.json
# SOLANA_SECRET_KEY=[1,2,3,...]

# Sensor timestamps older than this are rejected (milliseconds; default 5 minutes).
MAX_SENSOR_AGE_MS=300000
PORT=3000
